-- AirWalk: original-style following platform
local function stopAirWalk()
    states.AirWalk = false
    if platform then
        platform:Destroy()
        platform = nil
    end
end

local function startAirWalk()
    if not Root then error("Character not ready") end
    stopAirWalk()

    states.AirWalk = true
    platformY = Root.Position.Y - 3

    platform = Instance.new("Part")
    platform.Name = "STARCORE_AirWalkPlatform"
    platform.Size = Vector3.new(5, 1, 5)
    platform.Transparency = 1
    platform.Anchored = true
    platform.CanCollide = true
    platform.CanTouch = false
    platform.CanQuery = false
    platform.Parent = workspace

    task.spawn(function()
        while states.AirWalk and platform and platform.Parent do
            if Root and Root.Parent then
                platform.Position = Vector3.new(
                    Root.Position.X,
                    platformY,
                    Root.Position.Z
                )
            end
            task.wait()
        end
    end)
end

toggle("AirWalk", function(on)
    if on then
        startAirWalk()
    else
        stopAirWalk()
    end
end)

