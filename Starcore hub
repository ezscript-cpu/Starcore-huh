local function button(text, callback)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1, -3, 0, MOBILE and 27 or 38)
    b.BackgroundColor3 = PANEL
    b.BorderSizePixel = 0
    b.Text = text
    b.TextColor3 = WHITE
    b.Font = Enum.Font.GothamMedium
    b.TextSize = MOBILE and 10 or 14
    b.AutoButtonColor = true
    b.Parent = Scroll

    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 6)
    c.Parent = b

    local s = Instance.new("UIStroke")
    s.Color = Color3.fromRGB(65, 54, 83)
    s.Thickness = 1
    s.Parent = b

    b.Activated:Connect(function()
        local ok, err = pcall(callback)
        if not ok then
            warn("[STARCORE BUTTON ERROR] " .. text .. ": " .. tostring(err))
            notify(text .. " failed")
        end
    end)

    return b
end

local function toggle(name, callback)
    states[name] = false
    local b

    b = button(name .. "  [OFF]", function()
        local nextState = not states[name]
        local ok, err = pcall(function()
            callback(nextState)
        end)

        if not ok then
            warn("[STARCORE TOGGLE ERROR] " .. name .. ": " .. tostring(err))
            notify(name .. " failed")
            return
        end

        states[name] = nextState
        b.Text = name .. (nextState and "  [ON]" or "  [OFF]")
        b.BackgroundColor3 = nextState
            and Color3.fromRGB(65, 42, 100)
            or PANEL
    end)

    return b
end

