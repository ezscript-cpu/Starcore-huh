connections.update = RunService.Stepped:Connect(function()
    if states.Noclip and Character then
        for _, part in ipairs(Character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end

    if states.SlowFalling and Root then
        local velocity = Root.AssemblyLinearVelocity
        if velocity.Y < -8 then
            Root.AssemblyLinearVelocity = Vector3.new(
                velocity.X,
                math.max(velocity.Y, -8),
                velocity.Z
            )
        end
    end

    if states.AntiFall and Root and Humanoid then
        if Humanoid.FloorMaterial == Enum.Material.Air
        and Root.Position.Y < -30 then
            local spawnLocation = workspace:FindFirstChildWhichIsA("SpawnLocation", true)
            if spawnLocation then
                Root.CFrame = spawnLocation.CFrame + Vector3.new(0, 5, 0)
            end
        end
    end
end)

connections.rainbow = RunService.RenderStepped:Connect(function()
    if states.Rainbow and Main.Parent then
        local hue = (os.clock() % 5) / 5
        mainStroke.Color = Color3.fromHSV(hue, 0.8, 1)
        padStroke.Color = Color3.fromHSV(hue, 0.8, 1)
    end
end)

Players.PlayerAdded:Connect(function(target)
    target.CharacterAdded:Connect(function()
        task.wait(1)
        if states.ESP then
            rebuildESP()
        end
    end)
end)

Players.PlayerRemoving:Connect(function()
    if states.ESP then
        task.defer(rebuildESP)
    end
end)

Screen.Destroying:Connect(function()
    stopFly()
    stopAirWalk()
    clearESP()

    for _, connection in pairs(connections) do
        if connection then
            connection:Disconnect()
        end
    end
end)

notify("STARCORE V4 loaded")
